# =====================================================================
# Server backend — variables de entorno
# =====================================================================
# Cópialo a `env/.env` (que está gitignored, ver .gitignore línea 18)
# y completá los valores reales para tu entorno local.
#
# En Render NO se usa este archivo: las variables se setean directo en
# el panel (Environment → Environment Variables).
# =====================================================================

# --- Base de datos -------------------------------------------------------
# Si está VACÍO → el server usa H2 en memoria (útil para dev local, pero
# los datos se pierden en cada reinicio / redeploy).
#
# Si tiene una URL → se conecta a Postgres / Neon.
# Formato esperado (formato libpq / URL de conexión estándar):
#   postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require
#
# El código parsea esto y lo transpila a jdbc:postgresql://... en runtime
# (ver server/src/main/kotlin/.../Database.kt → toJdbc).
DATABASE_URL=

# --- Auth ----------------------------------------------------------------
# Requerido en PRODUCCIÓN. El código trae un default de dev
# (`daytesk-dev-secret-change-me`) que NO debes usar para usuarios reales.
#
# Generá uno nuevo con cualquiera de estas opciones (64 chars hex mínimo):
#   * openssl rand -hex 32                # Linux/macOS
#   * [Convert]::ToString((Get-Random -Count 32 -Maximum 256))          # PS naive
#   * Desde .NET:  (RNGCryptoServiceProvider).GetBytes(32) → hex
JWT_SECRET=replace-me-with-a-64-char-hex-string

# --- Server --------------------------------------------------------------
# Render lo inyecta automáticamente en cada deploy (no tocar acá).
# En local podés dejarlo en 8080 — el server bindea 0.0.0.0:8080.
PORT=8080

# --- Cliente (referencia, normalmente NO se setea acá) ------------------
# Esta variable la lee el cliente Android (no el server). Apunta a la URL
# base del API. Default: http://10.0.2.2:8080 (localhost del emulador).
# En prod el cliente apuntaría a https://TU-APP.onrender.com
# API_BASE_URL=http://10.0.2.2:8080
