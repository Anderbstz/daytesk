<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews-safe layout: only LinearLayout / ImageView / TextView.
  Single row, 1x2 footprint. The body opens the app on the Recordatorios
  screen; the trailing "+" zone launches RecordatorioCaptureActivity, which
  hosts the editable capture form (RemoteViews cannot host an EditText).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recordatorio_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_alarm" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recordatorio_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_recordatorio_empty"
            android:textColor="#1A1410"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recordatorio_widget_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8A8178"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/recordatorio_widget_add"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="+"
        android:textColor="#C46A3A"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
